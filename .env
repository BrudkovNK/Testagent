LLM_PROVIDER=gemini          # anthropic | openai | gemini

GEMINI_API_KEY= #Сюда ключ
GEMINI_MODEL=gemini-3.5-flash-lite

HEADLESS=false      
USER_DATA_DIR=./browser_profile
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
DEFAULT_START_URL=about:blank
SLOW_MO_MS=50

MAX_STEPS=40
ACTION_TIMEOUT_MS=15000
NAV_WAIT_MS=800

MAX_ELEMENTS_PER_STATE=120
MAX_HISTORY_STEPS=8
MAX_TEXT_FIELD_CHARS=200
USE_SCREENSHOTS=true
SCREENSHOT_MAX_WIDTH=1280

E_CONFIRMATION=true
