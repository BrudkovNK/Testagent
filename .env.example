# ---- LLM ----
# Выберите ОДИН провайдер. Если нет платного ключа Anthropic — см. варианты
# ниже: Gemini (бесплатный ключ) или локальный Ollama (без ключа вообще).
LLM_PROVIDER=anthropic          # anthropic | openai | gemini

# --- Вариант 1: Claude (платно) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Вариант 2: OpenAI (платно) ИЛИ локальный Ollama (бесплатно, без ключа) ---
# Для настоящего OpenAI: впишите ключ, OPENAI_BASE_URL оставьте пустым.
# Для локального Ollama: 1) установите Ollama, 2) ollama pull qwen2.5:7b
#   (нужна модель с поддержкой tool calling), 3) ollama serve, 4) впишите:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=ollama   (любая непустая строка, реально не проверяется)
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# --- Вариант 3: Google Gemini — РЕКОМЕНДУЕТСЯ, если нет платного ключа ---
# Бесплатный ключ без привязки карты: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Браузер ----
HEADLESS=false                  # по заданию браузер должен быть видимым
USER_DATA_DIR=./browser_profile # сюда сохраняется persistent-профиль (куки/сессии)
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
DEFAULT_START_URL=about:blank
SLOW_MO_MS=50

# ---- Цикл агента ----
MAX_STEPS=40
ACTION_TIMEOUT_MS=15000
NAV_WAIT_MS=800

# ---- Управление контекстом ----
MAX_ELEMENTS_PER_STATE=120
MAX_HISTORY_STEPS=8
MAX_TEXT_FIELD_CHARS=200
USE_SCREENSHOTS=true
SCREENSHOT_MAX_WIDTH=1280

# ---- Безопасность ----
REQUIRE_CONFIRMATION=true
